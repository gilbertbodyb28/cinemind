<?xml version="1.0" encoding="UTF-8"?>
<!-- Template. __RUNTIME__ is replaced with the runtime copy (~/CineMind) by
     scripts/install_cinemind_app.sh, which writes the real plist to
     ~/Library/LaunchAgents/com.cinemind.local.plist. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cinemind.local</string>
  <key>ProgramArguments</key>
  <array>
    <string>__RUNTIME__/scripts/run_cinemind_local.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__RUNTIME__/backend</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__RUNTIME__/.runtime/cinemind.log</string>
  <key>StandardErrorPath</key>
  <string>__RUNTIME__/.runtime/cinemind.error.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>PYTHONPATH</key>
    <string>__RUNTIME__/.runtime/python:__RUNTIME__/backend</string>
    <key>CINEMIND_APP_DIR</key>
    <string>__RUNTIME__</string>
  </dict>
</dict>
</plist>
