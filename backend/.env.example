# CineMind AI — backend configuration
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.

# ---------- Database ----------
MONGO_URL="mongodb://localhost:27017"
DB_NAME="cinemind"

# ---------- HTTP ----------
# Comma-separated list of allowed origins for the browser app.
CORS_ORIGINS="http://localhost:3000"

# ---------- Session cookie ----------
# Local dev over plain http needs COOKIE_SECURE=false / COOKIE_SAMESITE=lax.
# Behind HTTPS (or a cross-site frontend) use true / none.
COOKIE_SECURE="false"
COOKIE_SAMESITE="lax"
SESSION_TTL_DAYS="7"

# ---------- Demo data ----------
# Seeds sample watch history and recommendations when no provider is connected,
# so the app is explorable before you link Plex/Trakt/Simkl. Set false for real use.
DEMO_MODE="true"

# ---------- Ollama (local AI) ----------
# Per-user Ollama URL/model are stored in the database via the Connections page.
# These are the server-wide defaults used when a user has not set their own.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# ---------- TMDb ----------
# Free API key: https://www.themoviedb.org/settings/api
TMDB_API_KEY="your-tmdb-api-key"

# ---------- Trakt ----------
# Create an app at https://trakt.tv/oauth/applications
# Redirect URI must be: urn:ietf:wg:oauth:2.0:oob
TRAKT_CLIENT_ID="your-trakt-client-id"
TRAKT_CLIENT_SECRET="your-trakt-client-secret"

# ---------- Simkl ----------
# Create an app at https://simkl.com/settings/developer/
SIMKL_CLIENT_ID="your-simkl-client-id"
SIMKL_CLIENT_SECRET="your-simkl-client-secret"
