# CineMind AI — backend configuration
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.

# ---------- Database ----------
MONGO_URL="mongodb://localhost:27017"
DB_NAME="cinemind"

# ---------- HTTP ----------
# Comma-separated list of allowed origins for the browser app.
CORS_ORIGINS="http://localhost:3000"

# ---------- Session cookie ----------
# Local dev over plain http needs COOKIE_SECURE=false / COOKIE_SAMESITE=lax.
# Behind HTTPS (or a cross-site frontend) use true / none.
COOKIE_SECURE="false"
COOKIE_SAMESITE="lax"
SESSION_TTL_DAYS="7"

# ---------- Demo data ----------
# Seeds sample watch history and recommendations when no provider is connected,
# so the app is explorable before you link Plex/Trakt/Simkl. Set false for real use.
DEMO_MODE="true"

# ---------- Ollama (local AI) ----------
# Per-user Ollama URL/model are stored in the database via the Connections page.
# These are the server-wide defaults used when a user has not set their own.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gemma4:12b-it-qat"

# ---------- TMDb ----------
# Free API key: https://www.themoviedb.org/settings/api
TMDB_API_KEY="your-tmdb-api-key"

# ---------- Trakt ----------
# Create an app at https://trakt.tv/oauth/applications
# Redirect URI must be: urn:ietf:wg:oauth:2.0:oob
TRAKT_CLIENT_ID="your-trakt-client-id"
TRAKT_CLIENT_SECRET="your-trakt-client-secret"

# ---------- Simkl ----------
# Create an app at https://simkl.com/settings/developer/
SIMKL_CLIENT_ID="your-simkl-client-id"
SIMKL_CLIENT_SECRET="your-simkl-client-secret"

# ---------- AniList ----------
# Create an app at https://anilist.co/settings/developer
# The redirect URL registered there must match ANILIST_REDIRECT_URI exactly,
# or AniList answers the token exchange with invalid_client.
ANILIST_CLIENT_ID="your-anilist-client-id"
ANILIST_CLIENT_SECRET="your-anilist-client-secret"
ANILIST_REDIRECT_URI="http://localhost:8001/api/anilist/auth/callback"

# ---------- MediaManager ----------
# MediaManager base URL + admin credentials are stored per user on the
# Connections page (not required in this file). Approve on a recommendation
# calls MediaManager's movie/TV library APIs with monitored + search_now.
# Example URL: http://127.0.0.1:5173  (Vite UI proxies /api → MediaManager backend)
# Direct backend also works: http://127.0.0.1:8000
# CineMind API defaults to 8001 so it does not fight MediaManager's backend on 8000.
